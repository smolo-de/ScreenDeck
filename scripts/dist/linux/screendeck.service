[Unit]
Description=ScreenDeck – Steuerung von Browser-Screens
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=screendeck
Group=screendeck
Environment=DATA_DIR=/var/lib/screendeck
WorkingDirectory=/var/lib/screendeck
ExecStart=/opt/screendeck/screendeck
Restart=on-failure
RestartSec=3
# Port 80 (Adressen ohne Portangabe) ohne root-Rechte
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
